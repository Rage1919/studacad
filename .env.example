# Copy this file to .env.local for local development. Never commit real secrets.
STUDACAD_ENV=development
STUDACAD_APP_URL=http://localhost:3000

# Optional release metadata exposed by the minimal health endpoint.
STUDACAD_RELEASE_SHA=
STUDACAD_DEPLOYED_AT=

# Supabase Postgres, Auth, and private object storage. Use separate projects for
# local/staging and production. Never expose the secret key to browser code.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SECRET_KEY=replace-with-local-secret-key
SUPABASE_PRIVATE_BUCKET=studacad-private

# Direct or session-pooler Postgres URL used only by migration/backup tooling.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Synchronous malware-scanning gateway for private tutor evidence. Required in
# preview, staging, and production; upload requests fail closed if unavailable.
# The gateway receives multipart field `file` with a Bearer token and returns
# JSON: {"status":"clean"|"infected","reference":"provider-id"}.
STUDACAD_MALWARE_SCAN_URL=
STUDACAD_MALWARE_SCAN_TOKEN=

# Google Meet uses OAuth for one dedicated organizer account. The refresh token,
# client secret, and provisioner secret are server-only deployment secrets.
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REFRESH_TOKEN=
GOOGLE_MEET_ORGANIZER_EMAIL=
GOOGLE_MEET_LINK_RELEASE_MINUTES=1440
MEET_PROVISIONER_SECRET=
