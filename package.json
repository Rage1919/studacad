{
  "name": "studacad-learning-marketplace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "vinext build && node scripts/prepare-sites.mjs",
    "start": "node scripts/validate-runtime-env.mjs && node scripts/validate-database-env.mjs && vinext start",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check next.config.mjs proxy.ts playwright.config.ts app/api/whatsapp/route.ts server/security server/meet server/messages tests/e2e",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "security:dependencies": "pnpm audit --prod --audit-level high",
    "env:check": "node scripts/validate-runtime-env.mjs",
    "db:env:check": "node scripts/validate-database-env.mjs",
    "db:migrate": "node scripts/database/migrate.mjs",
    "db:seed:development": "node scripts/database/seed-development.mjs",
    "storage:delete-expired": "node scripts/storage/delete-expired-objects.mjs",
    "auth:bootstrap-admin": "node scripts/auth/bootstrap-admin.mjs",
    "check": "pnpm env:check && pnpm db:env:check && pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@next/env": "16.3.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "next": "16.3.0",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "24.2.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.22.0",
    "eslint-config-next": "16.3.0",
    "prettier": "^3.9.6",
    "typescript": "5.9.2",
    "vinext": "0.2.1"
  }
}
